{
  // Type-checks the pure layer only; nothing is emitted and the extension
  // still ships as plain JavaScript. Node types stand in for the web APIs that
  // browsers and Node share, without letting DOM or chrome.* types in.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitThis": true,
    "noFallthroughCasesInSwitch": true,
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["extension/lib/**/*.js"]
}
